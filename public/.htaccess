# Publixa Official Apache / LiteSpeed Configuration
# Domain: publixa.store

RewriteEngine On

# Route PHP API endpoints
RewriteRule ^api/support/?$ /api/support.php [L,QSA]
RewriteRule ^api/deletion-requests/?$ /api/deletion-requests.php [L,QSA]

# Custom Error Pages
ErrorDocument 404 /404.html
ErrorDocument 503 /error_pages/503.html

# Enable Proper MIME Types
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
